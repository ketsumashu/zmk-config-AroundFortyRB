#include <behaviors/rgbled_widget.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        tab {
            bindings = <&kp TAB>;
            key-positions = <0 1>;
            layers = <0>;
            timeout-ms = <40>;
            require-prior-idle-ms = <75>;
        };

        ctr {
            bindings = <&sk LCTRL>;
            key-positions = <10 11>;
            layers = <0 3>;
            timeout-ms = <40>;
            require-prior-idle-ms = <75>;
        };

        sft {
            bindings = <&sk LSHFT>;
            key-positions = <20 21>;
            layers = <0 3>;
            timeout-ms = <40>;
            require-prior-idle-ms = <75>;
        };

        bksp {
            bindings = <&kp BACKSPACE>;
            key-positions = <15 16>;
            layers = <0 3>;
            timeout-ms = <40>;
            require-prior-idle-ms = <75>;
        };

        parelf {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <6 7>;
            layers = <0>;
            timeout-ms = <40>;
            require-prior-idle-ms = <75>;
        };

        parergt {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <8 7>;
            layers = <0>;
            timeout-ms = <40>;
            require-prior-idle-ms = <75>;
        };

        bralf {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <17 16>;
            layers = <0>;
            timeout-ms = <40>;
            require-prior-idle-ms = <75>;
        };

        brargt {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <17 18>;
            layers = <0>;
            timeout-ms = <40>;
            require-prior-idle-ms = <75>;
        };

        quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <27 28>;
            layers = <0>;
            timeout-ms = <40>;
            require-prior-idle-ms = <75>;
        };

        equal {
            bindings = <&kp EQUAL>;
            key-positions = <18 19>;
            layers = <0>;
            timeout-ms = <40>;
            require-prior-idle-ms = <75>;
        };

        hyphen {
            bindings = <&kp MINUS>;
            key-positions = <8 9>;
            layers = <0>;
            timeout-ms = <40>;
            require-prior-idle-ms = <75>;
        };

        scroll {
            bindings = <&sl 5>;
            key-positions = <40 41>;
            timeout-ms = <40>;
            require-prior-idle-ms = <75>;
            layers = <0 3>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };

        // Windows用入力切り替え：Alt + Grave (~)

        ime_tog: ime_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp GRAVE>,
                <&macro_release>,
                <&kp LALT>;
        };

        // macOS用入力切り替え：Ctrl + Space

        mac_ime: mac_ime_toggle {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LCTRL>,
                <&macro_tap>,
                <&kp SPACE>,
                <&macro_release>,
                <&kp LCTRL>;
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // 

        scroll_up_down: behavior_sensor_rotate_mouse_wheel_up_down {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_UP>, <&msc SCRL_DOWN>;

            tap-ms = <20>;
        };

        layermod: layermod {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYERMOD";
            bindings = <&mo>, <&lt>;

            #binding-cells = <2>;
            tapping-term-ms = <120>;
        };

        midwheel: midwheel {
            compatible = "zmk,behavior-hold-tap";
            label = "MIDWHEEL";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <120>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "base";
            bindings = <
&kp Q      &kp W         &kp E           &kp R         &kp T                     &kp Y      &kp U  &kp I          &kp O     &kp P
&kp A      &kp S         &kp D           &kp F         &kp G                     &kp H      &kp J  &kp K          &kp L     &kp SEMI
&kp Z      &kp X         &kp C           &kp V         &kp B      &none          &kp N      &kp M  &kp COMMA      &kp DOT   &kp SLASH
&kp LCTRL  &kp LEFT_ALT  &kp LEFT_SHIFT  &kp LEFT_GUI  &kp SPACE  &layermod 1 1  &kp ENTER  &none  &layermod 2 2  &mkp MB1  &mkp MB2
            >;
        };

        layer1 {
            display-name = "1";
            bindings = <
&kp NUMBER_1          &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5             &kp NUMBER_6    &kp N7    &kp N8         &kp N9     &kp N0
&kp LC(A)             &kp LC(S)     &kp LC(D)     &kp LC(F)     &kp LC(G)          &kp LEFT_ARROW  &kp DOWN  &kp UP_ARROW   &kp RIGHT  &trans
&mt LEFT_SHIFT LC(Z)  &kp LC(X)     &kp LC(C)     &kp LC(V)     &kp LC(B)  &trans  &trans          &trans    &trans         &trans     &kp BACKSLASH
&trans                &trans        &trans        &trans        &trans     &none   &trans          &trans    &layermod 4 4  &trans     &trans
            >;
        };

        layer2 {
            display-name = "2";
            bindings = <
&kp EXCL    &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp LC(PERCENT)                 &kp CARET  &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp GRAVE
&kp ESCAPE  &trans       &trans    &trans      &trans                          &kp LEFT   &kp DOWN       &kp UP_ARROW  &kp RIGHT             &trans
&trans      &trans       &trans    &trans      &trans           &trans         &trans     &trans         &trans        &trans                &trans
&trans      &trans       &trans    &trans      &trans           &layermod 4 4  &trans     &trans         &none         &trans                &trans
            >;
        };

        AML {
            display-name = "AML";
            bindings = <
&none  &none  &none             &none            &none         &none  &none     &none            &none     &none
&none  &none  &none             &none            &none         &none  &mkp MB1  &midwheel 5 MB3  &mkp MB2  &none
&none  &none  &msc MOVE_Y(-15)  &msc MOVE_Y(15)  &none  &none  &none  &none     &none            &none     &none
&none  &none  &none             &none            &none  &none  &none  &none     &none            &none     &none
            >;
        };

        layer_4 {
            bindings = <
&kp F1        &kp F2        &kp F3        &kp F4          &kp F5              &kp F6  &kp F7           &kp F8  &kp F9     &kp F10
&kp F11       &kp F12       &none         &none           &bootloader         &none   &none            &none   &kp HOME   &kp END
&none         &none         &none         &none           &none        &none  &none   &kp PRINTSCREEN  &none   &kp PG_UP  &kp DEL
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_CLR_ALL  &none        &none  &none   &none            &none   &kp PG_DN  &kp INS
            >;

            label = "4";
        };

        scrollevent {
            bindings = <
&none  &none  &none  &none  &none         &none  &none  &none  &none  &none
&none  &none  &none  &none  &none         &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none  &none  &none  &none  &none  &none
            >;
        };
    };
};
